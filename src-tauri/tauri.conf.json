{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisplayProLite",
  "version": "0.2.0",
  "identifier": "com.local.displayprolite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1427",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DisplayProLite",
        "width": 1160,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#10131b",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 asset: http://asset.localhost data:; media-src \u0027self\u0027 asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
